# Use a unique random password before starting Docker. Keep .env private and untracked.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Host-only by default. A separate Docker sandbox may need a reachable host interface.
POSTGRES_BIND_ADDRESS=127.0.0.1
# pgAdmin web login; use a separate random password from POSTGRES_PASSWORD.
PGADMIN_DEFAULT_EMAIL=admin@localhost.test
PGADMIN_DEFAULT_PASSWORD=replace-with-another-long-random-password
